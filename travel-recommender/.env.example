# ---------------------------------------------------------------------------
# .env.example  -  실제 키 값은 절대 이 파일에 적지 않는다!
#
# 사용법:
#   1) 이 파일을 복사해서 .env 파일을 만든다.
#        cp .env.example .env
#   2) .env 파일의 your_api_key_here 부분을 발급받은 실제 키로 바꾼다.
#   3) .env 는 .gitignore 에 등록되어 있으므로 절대 커밋되지 않는다.
# ---------------------------------------------------------------------------

# [필수] Google Gemini API 키 (https://aistudio.google.com/apikey)
#        무료 티어로 발급 가능하며 카드 등록이 필요 없다.
GEMINI_API_KEY=your_api_key_here

# [필수] Kakao Developers REST API 키 (https://developers.kakao.com)
#        내 애플리케이션 > 앱 키 > "REST API 키" 값을 사용한다. (JavaScript 키 아님)
KAKAO_REST_API_KEY=your_api_key_here

# [선택] 사용할 LLM 모델 이름. 지정하지 않으면 gemini-flash-latest 를 사용한다.
#        gemini-flash-latest 는 "항상 최신 flash 모델"을 가리키는 별칭이라
#        특정 버전이 단종돼도 코드가 깨지지 않는다.
#        특정 버전으로 고정하려면 아래 값을 바꾸면 된다. (예: gemini-3.5-flash)
GEMINI_MODEL=gemini-flash-latest
