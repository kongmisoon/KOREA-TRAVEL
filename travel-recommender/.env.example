# ---------------------------------------------------------------------------
# .env.example  -  실제 키 값은 절대 이 파일에 적지 않는다!
#
# 사용법:
#   1) 이 파일을 복사해서 .env 파일을 만든다.
#        cp .env.example .env
#   2) .env 파일의 your_api_key_here 부분을 발급받은 실제 키로 바꾼다.
#   3) .env 는 .gitignore 에 등록되어 있으므로 절대 커밋되지 않는다.
# ---------------------------------------------------------------------------

# [필수] OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_api_key_here

# [필수] Kakao Developers REST API 키 (https://developers.kakao.com)
#        내 애플리케이션 > 앱 키 > "REST API 키" 값을 사용한다. (JavaScript 키 아님)
KAKAO_REST_API_KEY=your_api_key_here

# [선택] 사용할 LLM 모델 이름. 지정하지 않으면 gpt-4o-mini 를 사용한다.
OPENAI_MODEL=gpt-4o-mini
